#!/bin/sh
# Validate conventional commit format and block AI attribution trailers

MSG_FILE="$1"

# Run commitlint (exits if invalid)
"$(git rev-parse --show-toplevel)/node_modules/.bin/commitlint" --edit "$MSG_FILE"

# Block AI attribution trailers
sh "$(git rev-parse --show-toplevel)/.husky/check-attribution" "$MSG_FILE"
