{
  "name": "@soonwhy/sdk-node",
  "version": "0.1.0",
  "description": "Node.js OpenTelemetry instrumentation for Soonwhy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": false },
    "@opentelemetry/auto-instrumentations-node": { "optional": false },
    "@opentelemetry/exporter-trace-otlp-proto": { "optional": false },
    "@opentelemetry/resources": { "optional": false },
    "@opentelemetry/sdk-node": { "optional": false },
    "@opentelemetry/sdk-trace-base": { "optional": false }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
