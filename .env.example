# Copy to `.env` for host processes (`pnpm dev`, drizzle).
# `docker compose up` already injects the in-network URLs from docker-compose.yml.
# Host values below point at the ports that compose publishes.

# --- Application ---
NODE_ENV=development
# Leave PORT unset at the repo root. The API defaults to 3001 and ingest to 3002.
# Setting PORT here would make both processes share one port.
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
# Required by the API. Local placeholder only; replace before any shared deployment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# UI (Vite). Falls back to http://localhost:3001 when unset.
# VITE_API_URL=http://localhost:3001/api/v1

# --- PostgreSQL (docker-compose service `postgres`) ---
# user / password / database match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB.
# Inside compose the host is `postgres`, not localhost.
# Docker publishes Postgres on 5433 because a host Postgres already uses 5432.
DATABASE_URL=postgres://soonwhy:soonwhy@localhost:5433/soonwhy
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT_SECONDS=20
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_MAX_LIFETIME_SECONDS=1800

# --- Redis (docker-compose service `redis`) ---
# Docker publishes Redis on 6380 because a host Redis already uses 6379.
REDIS_URL=redis://localhost:6380
# RATE_LIMIT_PER_MINUTE=10000

# --- NATS (docker-compose service `nats`, JetStream enabled) ---
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TELEMETRY
# NATS_MAX_BYTES=1073741824
# NATS_MAX_AGE_NS=86400000000000
# NATS_MAX_ACK_PENDING=1000

# --- Quickwit (docker-compose service `quickwit`, store is MinIO) ---
QUICKWIT_URL=http://localhost:7280

# --- MinIO (local S3). Optional cold storage for the cron archival job. ---
# Unset R2_ENDPOINT to leave archival disabled.
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose are soonwhy / soonwhy-secret.
# Console: http://localhost:9001  API: http://localhost:9000
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY=soonwhy
# R2_SECRET_KEY=soonwhy-secret
# R2_BUCKET=soonwhy-telemetry

# --- OAuth (optional; email/password still works when these are unset) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Root-cause analysis (optional) ---
# SOONWHY_RCA_API_KEY=
# SOONWHY_RCA_MODEL=
# SOONWHY_RCA_BASE_URL=
# SOONWHY_RCA_PROVIDER=openai-compatible
# SOONWHY_RCA_TIMEOUT_MS=
# SOONWHY_RCA_MAX_PROMPT_CHARACTERS=
# SOONWHY_RCA_MAX_RETRIES=
# SOONWHY_RCA_PROMPT_VERSION=

# --- Ingest tuning (optional) ---
# INGEST_MAX_CONCURRENCY=100
# INGEST_MAX_CONCURRENCY_PER_ORG=

# --- SDK / examples/node (not read by the API itself) ---
# SOONWHY_API_KEY=sk_replace_me
# SOONWHY_ENDPOINT=http://localhost:3002/v1
