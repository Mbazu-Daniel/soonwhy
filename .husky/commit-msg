#!/bin/sh
# Husky commit-msg hook
# Validates conventional commit format and blocks AI attribution

# Run commitlint (exits if invalid)
"$(git rev-parse --show-toplevel)/node_modules/.bin/commitlint" --edit "$1"

# Run existing commit-msg checks (blocks AI attribution)
"$(git rev-parse --show-toplevel)/.githooks/commit-msg" "$1"
