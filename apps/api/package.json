{
  "name": "@soonwhy/backend",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "test": "vitest",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "test:integration": "RUN_DB_TESTS=1 node test/setup-test-database.mjs && RUN_DB_TESTS=1 vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/common/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@mastra/core": "^1.79.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/idempotency": "^0.0.4",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-node": "^12.4.1",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@soonwhy/shared": "workspace:*",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.12.1",
    "nats": "^2.29.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.0",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "zod": "^3.25.76",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist",
    "src",
    "drizzle",
    "drizzle.config.ts",
    "nest-cli.json",
    "tsconfig.json"
