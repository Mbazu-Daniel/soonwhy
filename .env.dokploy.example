# Dokploy env for the backend stack (docker-compose.dokploy.yml).
# Copy into the dokploy env form for the project — do NOT commit real values.
NODE_ENV=production
PORT=3001
INGEST_PORT=3002

# Image tag to deploy: dev (current), main after next merge, or sha-<shortsha>
IMAGE_TAG=dev

# Postgres + Redis included in the compose; delete those services and point
# these elsewhere if you use dokploy-managed or external infra instead.
POSTGRES_USER=soonwhy
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=soonwhy
DATABASE_URL=postgres://soonwhy:change-me-long-random@postgres:5432/soonwhy
REDIS_URL=redis://redis:6379

# Telemetry stack. Valid when api/ingest run in the same dokploy project as
# the nats/quickwit stack (service names resolve on the project network).
# Otherwise set full internal/container URLs.
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=TELEMETRY
QUICKWIT_URL=http://quickwit:7280

# Auth + frontend
BETTER_AUTH_URL=https://api-soonwhy.oktopals.com
BETTER_AUTH_SECRET=change-me-long-random
FRONTEND_URL=
DEFAULT_FROM_EMAIL=noreply@oktopals.com
ZEPTOMAIL_API_KEY=

# AI + privacy
SOONWHY_PII_ENCRYPTION_KEY=
SOONWHY_AI_QUOTA_ENFORCED=false

# api self-telemetry into ingest (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://ingest:3002
