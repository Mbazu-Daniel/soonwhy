{
  "name": "soonwhy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "turbo dev --filter=@soonwhy/backend --filter=@soonwhy/frontend --filter=@soonwhy/ingest",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "test": "pnpm --filter @soonwhy/shared build && pnpm --filter @soonwhy/node build && vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "prepare": "husky",
    "registry:up": "docker compose -f docker-compose.verdaccio.yml up -d",
    "registry:down": "docker compose -f docker-compose.verdaccio.yml down",
    "registry:logs": "docker compose -f docker-compose.verdaccio.yml logs -f",
    "publish:local": "node scripts/publish-local.mjs",
    "release:sdk": "node scripts/release-sdk.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.11.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.11.10",
    "vitest": "^3.2.0"
  }
}
