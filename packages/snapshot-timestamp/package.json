{
  "name": "soonwhy-snapshot-timestamp",
  "version": "0.0.0",
  "description": "Small timestamp utility used to verify local Soonwhy package publishing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
