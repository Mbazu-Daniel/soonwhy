# Shared env for the two backend stacks: docker-compose.api.yml and
# docker-compose.ingest.yml. Paste the same contents into each app's env
# form on the server (one .env per app). Do NOT commit real values.
# Both apps must share the external network: docker network create soonwhy-backend
NODE_ENV=production
PORT=3001
INGEST_PORT=3002

# Image tag: dev (only tag published).
IMAGE_TAG=dev

# Your own Postgres — required. For TLS-managed providers append
# ?sslmode=require, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://user:password@your-db-host:5432/soonwhy

# Your own Redis — required. Use rediss:// for TLS-managed providers.
REDIS_URL=redis://default:password@your-redis-host:6379

# Cloudflare R2 (quickwit metastore + indexes). Required.
R2_ENDPOINT=
R2_BUCKET=soonwhy
R2_PREFIX=quickwit
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
QUICKWIT_CLUSTER_ID=soonwhy

# Ingest (internal). Also set in the compose for the api service;
# duplicated here so the value is explicit if you ever run api outside the compose.
INGEST_URL=http://ingest:3002

# Telemetry (internal URLs — service names resolve on the ingest app's project network)
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=TELEMETRY
QUICKWIT_URL=http://quickwit:7280

# Auth + frontend
BETTER_AUTH_URL=https://api-soonwhy.oktopals.com
BETTER_AUTH_SECRET=change-me-long-random
FRONTEND_URL=
DEFAULT_FROM_EMAIL=noreply@oktopals.com
ZEPTOMAIL_API_KEY=

# AI + privacy
SOONWHY_PII_ENCRYPTION_KEY=
SOONWHY_AI_QUOTA_ENFORCED=false

# api self-telemetry into ingest (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://ingest:3002
