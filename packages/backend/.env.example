# Local infrastructure (NATS + ClickHouse)
# Requires: .dev/bin/nats-server and .dev/clickhouse/clickhouse (see scripts/dev-infra.sh)

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=soonwhy
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TELEMETRY

# Optional: Cloudflare R2 cold storage
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=soonwhy-telemetry
