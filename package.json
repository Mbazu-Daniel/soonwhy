{
  "name": "soonwhy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @soonwhy/shared build && pnpm --filter './apps/*' --filter './packages/{cron,ingest}' dev",
    "build": "pnpm --filter @soonwhy/shared build && pnpm --filter @soonwhy/sdk build && pnpm --filter './apps/*' --filter './packages/{cron,ingest}' --filter './sdks/*' build",
    "test": "pnpm --filter @soonwhy/shared build && vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "prepare": "husky",
    "registry:up": "docker compose -f docker-compose.verdaccio.yml up -d",
    "registry:down": "docker compose -f docker-compose.verdaccio.yml down",
    "registry:logs": "docker compose -f docker-compose.verdaccio.yml logs -f",
    "publish:local": "node scripts/publish-local.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.11.0",
    "oxlint": "^1.80.0",
    "vitest": "^3.2.0"
  }
}
