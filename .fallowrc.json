{
  // JSONC consumed by fallow.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/*/src/index.ts",
    "apps/*/src/main.ts",
    "packages/*/src/index.ts",
    "packages/*/src/main.ts"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/*"
    ]
  },
  "ignorePatterns": [
    "examples/**"
  ],
  "ignoreDependencies": [
    "@nestjs/schematics"
  ],
  "ignoreExports": [
    {
      "file": "apps/api/src/modules/v1/detections/detection.engine.ts",
      "exports": ["evaluateThroughput"]
    },
    {
      "file": "apps/api/src/modules/v1/intelligence/performance.engine.ts",
      "exports": ["evaluateThroughput"]
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
