{
  // JSONC consumed by fallow.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/*/src/index.ts",
    "apps/*/src/main.ts",
    "packages/*/src/index.ts",
    "packages/*/src/main.ts"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/*"
    ]
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
