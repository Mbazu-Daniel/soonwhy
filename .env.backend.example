# Env for the production stack: docker-compose.stack.yml (api + ingest + telemetry),
# one Dokploy compose app. Paste into the app's env form on the server.
# Do NOT commit real values.
#
# Only values that differ per deployment live here. Ports, internal service
# URLs (nats, quickwit, ingest) and NODE_ENV are set in docker-compose.stack.yml.

# Your own Postgres — required. For TLS-managed providers append
# ?sslmode=require, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://user:password@your-db-host:5432/soonwhy
# Connections per service (api and ingest each open up to this many). Default 10.
# DB_POOL_MAX=10
REDIS_URL=redis://default:password@your-redis-host:6379

# Cloudflare R2 (quickwit metastore + indexes). Required.
R2_ENDPOINT=
R2_BUCKET=soonwhy
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, defaults shown: R2_PREFIX=quickwit  R2_REGION=auto  R2_FORCE_PATH_STYLE=true

# Auth + frontend
BETTER_AUTH_URL=https://api-soonwhy.oktopals.com
BETTER_AUTH_SECRET=change-me-long-random
FRONTEND_URL=
DEFAULT_FROM_EMAIL=noreply@oktopals.com
ZEPTOMAIL_API_KEY=

# AI + privacy
SOONWHY_PII_ENCRYPTION_KEY=
SOONWHY_AI_QUOTA_ENFORCED=false

# Host metrics collector (Infrastructure page) needs nothing here. Ingest picks
# the oldest project in the database the first time host metrics arrive and saves
# the choice as host_metrics_project_id in platform_settings. Every project in
# that project's organization shows the data.

# Self-observability (api self-telemetry into ingest) is
# disabled. Set to "true" only if you want the api to dogfood its own
# telemetry into the ingest pipeline.
SELF_OBSERVABILITY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT is ignored unless SELF_OBSERVABILITY_ENABLED=true.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://ingest:3002
# Trace sampling: parentbased_traceidratio with this root ratio (0.0-1.0). Defaults to 0.1.
# SOONWHY_TRACE_SAMPLE_RATIO=0.1
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Postgres statement and idle-in-transaction timeouts (milliseconds).
# A statement running longer than statement_timeout is cancelled; a
# transaction idle longer than idle_in_transaction_session_timeout is rolled back.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Evidence graph in-memory bounds
# EVIDENCE_GRAPH_MAX_ORGS=50
# EVIDENCE_GRAPH_MAX_ENTRIES=5000

# Synthetic probe scheduler concurrency cap
# SYNTHETIC_PROBE_CONCURRENCY=10

# Bearer token required at /api/v1/health/dependencies in production.
# Without it the endpoint answers 404 in production; in development it is open.
# HEALTH_DETAILS_TOKEN=
# Bearer token required for the ingest /api/health/stats details endpoint.
# INGEST_HEALTH_TOKEN=
# Log an ALERT when Quickwit rejects at least this many documents between two one-minute checks
# (rejected documents are saved to the dead-letter queue). Default 10.
# INGEST_REJECTED_DOCS_ALERT_THRESHOLD=10
# Webhook that receives ingest alerts (rejected documents, duplicates in the index) as
# {"text": "..."}, which Slack incoming webhooks accept. Unset means alerts are only logged.
# INGEST_ALERT_WEBHOOK_URL=
# How often the index is checked for event ids stored more than once, in milliseconds (0 turns it off). Default 600000.
# INGEST_DUPLICATE_CHECK_INTERVAL_MS=600000
# How far back each duplicate check looks, in seconds. The window ends one receipt lease ago. Default 3600.
# INGEST_DUPLICATE_WINDOW_SECS=3600
# JetStream duplicate-detection window in nanoseconds, used for replayed dead-letter messages.
# Default 1 hour; never above NATS_MAX_AGE_NS.
# NATS_DUPLICATE_WINDOW_NS=3600000000000

# Single sign-on with any OpenID Connect provider (Okta, Entra ID, Keycloak, Auth0, Google Workspace).
# All three of OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET turn it on.
# Register this redirect URL with the provider: <BETTER_AUTH_URL>/api/auth/callback/<OIDC_PROVIDER_ID>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_ID=oidc
# OIDC_DISPLAY_NAME=Single sign-on
# OIDC_SCOPES=openid email profile
